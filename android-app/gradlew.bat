@rem Gradle wrapper startup script for Windows (Gradle 8.10).
@rem The matching gradle-wrapper.jar is generated by running `gradle wrapper`.
@echo off
setlocal
set DIRNAME=%~dp0
if "%DIRNAME%" == "" set DIRNAME=.
set APP_HOME=%DIRNAME%
set JAR=%APP_HOME%gradle\wrapper\gradle-wrapper.jar
if not exist "%JAR%" (
    echo gradle-wrapper.jar not found. Run 'gradle wrapper' once ^(see android-app/README.md^).
    exit /b 1
)
if defined JAVA_HOME (set JAVA_EXE=%JAVA_HOME%\bin\java.exe) else (set JAVA_EXE=java.exe)
"%JAVA_EXE%" %JAVA_OPTS% %GRADLE_OPTS% -classpath "%JAR%" org.gradle.wrapper.GradleWrapperMain %*
endlocal
